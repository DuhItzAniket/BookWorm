APP_NAME=BookWorm
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=sqlite:///./bookworm.db
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_MB=20
MAX_PAGES=500
MAX_EXTRACTED_CHARS=2000000
TOP_K=5
QA_MODEL_NAME=deepset/bert-base-cased-squad2
QA_MODEL_REVISION=d378e310c8000d824954c1e76c943a0581b49f0c
QA_DEVICE=cpu
QA_THRESHOLD=0.08
# Required when ENVIRONMENT=production. Enter in the UI; never put in NEXT_PUBLIC_*.
DEMO_ACCESS_TOKEN=
# Optional, server-only. Web search stays disabled when absent.
BRAVE_SEARCH_API_KEY=

# Future Glypharis release only. The current upstream package has no trained engine.
OCR_PROVIDER=disabled
GLYPHARIS_MODEL_PATH=
OCR_MIN_NATIVE_CHARS=40
OCR_MAX_PAGES=5
OCR_RENDER_DPI=150
OCR_MAX_PIXELS=8000000
